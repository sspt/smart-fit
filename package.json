{
  "name": "smart-fit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/finalize.mjs",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "node scripts/smoke.mjs",
    "test:mobile": "node scripts/mobile-ui.mjs",
    "test:discovery": "node scripts/discovery-smoke.mjs",
    "test:cache": "node scripts/cache-smoke.mjs",
    "test:guided": "node scripts/guided-smoke.mjs",
    "test:compact": "node scripts/compact-smoke.mjs",
    "media:encode": "node scripts/encode-hls.mjs",
    "media:publish-nas": "node scripts/publish-nas.mjs",
    "media:upload-r2": "node scripts/upload-hls.mjs",
    "test:nas": "node scripts/nas-smoke.mjs",
    "test:hls": "node scripts/hls-smoke.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.187.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
